Size the locale name buffers for what a build without _MB_CAPABLE stores.
The global locale shrinks from 364 to about 104 bytes of RAM on ESP8266.

--- a/newlib/libc/locale/setlocale.h
+++ b/newlib/libc/locale/setlocale.h
@@ -177,7 +177,12 @@
 
 struct __locale_t
 {
+#ifdef _MB_CAPABLE
   char			 categories[_LC_LAST][ENCODING_LEN + 1];
+#else
+  /* Without _MB_CAPABLE only "C" is ever stored and nothing reads it back.  */
+  char			 categories[_LC_LAST][2];
+#endif
   int			(*wctomb) (struct _reent *, char *, wchar_t,
 				   mbstate_t *);
   int			(*mbtowc) (struct _reent *, wchar_t *,
@@ -187,9 +192,15 @@
   struct lconv		 lconv;
 #ifndef __HAVE_LOCALE_INFO__
   char			 mb_cur_max[2];
+#ifdef _MB_CAPABLE
   char			 ctype_codeset[ENCODING_LEN + 1];
   char			 message_codeset[ENCODING_LEN + 1];
 #else
+  /* Always "ASCII" without _MB_CAPABLE.  */
+  char			 ctype_codeset[sizeof "ASCII"];
+  char			 message_codeset[sizeof "ASCII"];
+#endif
+#else
   struct __lc_cats	 lc_cat[_LC_LAST];
 #endif
 };
